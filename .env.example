# ==============================================================================
# ClaimRecon AI — Environment Configuration Template
# ==============================================================================

# ─── LLM Provider Selection ───────────────────────────────────────────────────
# Options: azure_openai | gemini | openai | anthropic
LLM_PROVIDER=azure_openai

# Model or Deployment Name
# For Azure OpenAI: the deployment name in Azure AI Studio (e.g., gpt-4o)
# For Gemini: e.g., gemini-2.0-flash or gemini-3.8-flash
# For OpenAI: e.g., gpt-4o or gpt-4o-mini
LLM_MODEL=gpt-4o

# ─── Azure OpenAI Configuration ───────────────────────────────────────────────
# Azure OpenAI Endpoint URL (e.g. https://<your-resource-name>.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Deployment name of your model in Azure OpenAI
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI API Version
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# Passwordless Authentication (Recommended):
# Leave AZURE_OPENAI_API_KEY commented out to use Microsoft Entra ID (Managed Identity)
# via DefaultAzureCredential. Ensure the Container App / Managed Identity has
# the "Cognitive Services OpenAI User" role assigned on the Azure OpenAI resource.
#
# Optional fallback (only if using API key):
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here

# ─── Other Providers (Optional) ───────────────────────────────────────────────
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

